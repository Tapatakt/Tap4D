<Window x:Class="Tap4D.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tap4D Viewer" Height="900" Width="830" Background="Black"
        Cursor="None"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp"
        MouseWheel="OnMouseWheel"
        MouseDown="OnMouseButton" MouseUp="OnMouseButton">
    <Grid>
        <Image x:Name="RenderImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Foreground="Gray" FontSize="12" Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Text="Mouse: yaw/pitch, wheel: XW, XButtons: lean YW&#x0a;Q/E: roll XY, Z/X: rotate ZW&#x0a;W/S A/D T/G: move XZW, R/F: up/down&#x0a;+/-: near plane, P: planar/raycast, M: solid/wire/lines, Esc: quit"/>
    </Grid>
</Window>
